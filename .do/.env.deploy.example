# Example values file for .do/deploy.sh (INFRA-008).
#
# Copy this file to .do/.env.deploy.<environment> (e.g. .do/.env.deploy.prod)
# and fill in the real values. That file is git-ignored — it must never be
# committed. This example file is tracked and must never contain a real
# secret value; secret-classified keys below are left blank on purpose.
#
# Run the deploy with:
#   .do/deploy.sh .do/.env.deploy.<environment>

# --- App identity / source ---
DO_APP_NAME=duck-stack-services-dev
GITHUB_REPO=your-org/duck-stack
GIT_BRANCH=master

# --- serverConfig ---
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# CORS_ORIGIN: comma-separated list of full origins, with no trailing slash
# (e.g. https://duck-stack-web.pages.dev,https://duck-stack-landing.pages.dev).
# A single-origin deployment may use one plain origin value.
CORS_ORIGIN=https://app.example.com
# DATABASE_URL: Supabase Postgres connection string. Secret — fill in per
# environment, never commit a real value.
DATABASE_URL=

# --- authConfig (Clerk) ---
# CLERK_SECRET_KEY: Clerk backend secret key. Secret.
CLERK_SECRET_KEY=
# CLERK_JWT_KEY: Clerk JWT verification key. Secret.
CLERK_JWT_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET: Clerk webhook signing secret. Secret.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- email (RESEND adapter) ---
EMAIL_SENDER_ADDRESS=notifications@example.com
RESEND_API_KEY=

# --- mobbexConfig / billing ---
BILLING_PROVIDER=mobbex
# MOBBEX_API_KEY: Mobbex API key. Secret.
MOBBEX_API_KEY=
# MOBBEX_ACCESS_TOKEN: Mobbex access token. Secret.
MOBBEX_ACCESS_TOKEN=
MOBBEX_TEST_MODE=true
MOBBEX_TIMEOUT_MS=10000
# MOBBEX_WEBHOOK_SECRET: Mobbex webhook signing secret. Secret.
MOBBEX_WEBHOOK_SECRET=

# --- subscriptionsConfig ---
SIGNUP_MODE=open
FREE_TRIAL_DAYS=14
STRICT_ENTITLEMENTS_ON_PAST_DUE=false

# --- monitoring & log forwarding (INFRA-011) ---
# BETTERSTACK_LOGS_TOKEN: Better Stack Logs source ingestion token, consumed
# by .do/app.yaml's log_destinations entry. Secret.
BETTERSTACK_LOGS_TOKEN=
# BETTERSTACK_API_TOKEN: Better Stack team-scoped API token used by
# .do/monitoring/deploy.sh to reconcile the Uptime monitor and invite the
# alert recipient. Secret.
BETTERSTACK_API_TOKEN=
# BETTERSTACK_ALERT_EMAIL: recipient invited into the Better Stack team for
# this environment; receives the downtime/recovery notifications. Secret.
BETTERSTACK_ALERT_EMAIL=
# BETTERSTACK_MONITOR_URL: public /health URL probed by the Uptime monitor —
# the same URL .do/deploy.sh prints for this environment.
BETTERSTACK_MONITOR_URL=https://duck-stack-services-dev.ondigitalocean.app/health
# BETTERSTACK_CHECK_FREQUENCY_SECONDS: probe interval, in seconds — use the
# shortest interval the contracted Better Stack plan allows.
BETTERSTACK_CHECK_FREQUENCY_SECONDS=30
# BETTERSTACK_CHECK_TIMEOUT_SECONDS: seconds to wait for a response before
# classifying a probe as failed.
BETTERSTACK_CHECK_TIMEOUT_SECONDS=10


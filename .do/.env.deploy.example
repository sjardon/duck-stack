# Example values file for .do/deploy.sh (INFRA-008).
#
# Copy this file to .do/.env.deploy.<environment> (e.g. .do/.env.deploy.prod)
# and fill in the real values. That file is git-ignored — it must never be
# committed. This example file is tracked and must never contain a real
# secret value; secret-classified keys below are left blank on purpose.
#
# Run the deploy with:
#   .do/deploy.sh .do/.env.deploy.<environment>

# --- App identity / source ---
DO_APP_NAME=duck-stack-services-dev
GITHUB_REPO=your-org/duck-stack
GIT_BRANCH=master

# --- serverConfig ---
NODE_ENV=production
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
# CORS_ORIGIN: comma-separated list of full origins, with no trailing slash
# (e.g. https://duck-stack-web.pages.dev,https://duck-stack-landing.pages.dev).
# A single-origin deployment may use one plain origin value.
CORS_ORIGIN=https://app.example.com
# DATABASE_URL: Supabase Postgres connection string. Secret — fill in per
# environment, never commit a real value.
DATABASE_URL=

# --- authConfig (Clerk) ---
# CLERK_SECRET_KEY: Clerk backend secret key. Secret.
CLERK_SECRET_KEY=
# CLERK_JWT_KEY: Clerk JWT verification key. Secret.
CLERK_JWT_KEY=
# CLERK_WEBHOOK_SIGNING_SECRET: Clerk webhook signing secret. Secret.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- email (SES adapter) ---
EMAIL_SENDER_ADDRESS=notifications@example.com
# SES_REGION: placeholder pending migration of the email adapter off AWS SES
# (EC004); any non-empty value is enough for the container to start.
SES_REGION=us-east-1

# --- mobbexConfig / billing ---
BILLING_PROVIDER=mobbex
# MOBBEX_API_KEY: Mobbex API key. Secret.
MOBBEX_API_KEY=
# MOBBEX_ACCESS_TOKEN: Mobbex access token. Secret.
MOBBEX_ACCESS_TOKEN=
MOBBEX_TEST_MODE=true
MOBBEX_TIMEOUT_MS=10000
# MOBBEX_WEBHOOK_SECRET: Mobbex webhook signing secret. Secret.
MOBBEX_WEBHOOK_SECRET=

# --- subscriptionsConfig ---
SIGNUP_MODE=open
FREE_TRIAL_DAYS=14
STRICT_ENTITLEMENTS_ON_PAST_DUE=false

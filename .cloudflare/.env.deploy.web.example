# Example values file for `.cloudflare/deploy.sh web` (INFRA-009).
#
# Copy this file to .cloudflare/.env.deploy.web.<environment> (e.g.
# .cloudflare/.env.deploy.web.prod) and fill in the real values. That file is
# git-ignored — it must never be committed. This example file is tracked and
# must never contain a real secret value.
#
# Only public-classified values belong in this file: everything below is
# either a deploy-time credential (never inlined into the published bundle)
# or a VITE_* value that Vite inlines into the built bundle and is therefore
# publicly readable by anyone who downloads it. Never add a secret-classified
# variable here.
#
# Run the deploy with:
#   .cloudflare/deploy.sh web .cloudflare/.env.deploy.web.<environment>

# --- Cloudflare account / project ---
CLOUDFLARE_ACCOUNT_ID=dummy-account-id
# CLOUDFLARE_API_TOKEN: Cloudflare API token with Pages edit permissions.
# This is a deploy credential used only by `wrangler` locally/in CI — it is
# never part of the published bundle. Secret — fill in per environment,
# never commit a real value.
CLOUDFLARE_API_TOKEN=

# CLOUDFLARE_PROJECT_NAME defaults to duck-stack-web when unset — one
# project serves every environment (production + preview branches).
# CLOUDFLARE_PROJECT_NAME=duck-stack-web

# PRODUCTION_BRANCH defaults to main when unset.
# PRODUCTION_BRANCH=main

GIT_BRANCH=main

# --- Build-time configuration (inlined into the published bundle) ---
VITE_API_URL=https://api.example.test
VITE_CLERK_PUBLISHABLE_KEY=pk_test_dummy
VITE_LANDING_URL=https://landing.example.test
VITE_PROVIDER_PORTAL_URL=https://portal.example.test

# --- Error tracking (WEB-002, optional) ---
# Public, VITE_*-prefixed values: inlined into the published bundle, safe to
# commit as dummy/example values here. Leaving VITE_ERROR_TRACKING_DSN unset
# disables error tracking entirely.
VITE_ERROR_TRACKING_DSN=
# VITE_RELEASE=dummy-release-id
# VITE_ENVIRONMENT=production

# Deploy-time only credentials for the source-map upload performed during
# `vite build`. Never VITE_*-prefixed, never inlined into the published
# bundle. Secret — fill in per environment, never commit a real value.
# When SENTRY_AUTH_TOKEN is unset, the build emits no source maps.
SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_URL=

# Example values file for `.cloudflare/deploy.sh landing` (INFRA-009).
#
# Copy this file to .cloudflare/.env.deploy.landing.<environment> (e.g.
# .cloudflare/.env.deploy.landing.prod) and fill in the real values. That
# file is git-ignored — it must never be committed. This example file is
# tracked and must never contain a real secret value.
#
# Only public-classified values belong in this file: everything below is
# either a deploy-time credential (never inlined into the published bundle)
# or a VITE_* value that Vite inlines into the built bundle and is therefore
# publicly readable by anyone who downloads it. Never add a secret-classified
# variable here.
#
# Run the deploy with:
#   .cloudflare/deploy.sh landing .cloudflare/.env.deploy.landing.<environment>

# --- Cloudflare account / project ---
CLOUDFLARE_ACCOUNT_ID=dummy-account-id
# CLOUDFLARE_API_TOKEN: Cloudflare API token with Pages edit permissions.
# This is a deploy credential used only by `wrangler` locally/in CI — it is
# never part of the published bundle. Secret — fill in per environment,
# never commit a real value.
CLOUDFLARE_API_TOKEN=

# CLOUDFLARE_PROJECT_NAME defaults to duck-stack-landing when unset — one
# project serves every environment (production + preview branches).
# CLOUDFLARE_PROJECT_NAME=duck-stack-landing

# PRODUCTION_BRANCH defaults to main when unset.
# PRODUCTION_BRANCH=main

GIT_BRANCH=main

# --- Build-time configuration (inlined into the published bundle) ---
VITE_API_URL=https://api.example.test
VITE_WEB_URL=https://web.example.test

VITE_ERROR_TRACKING_DSN=
# VITE_RELEASE=dummy-release-id
# VITE_ENVIRONMENT=production